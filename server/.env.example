# Browser Origin allowlist (comma-separated). Requests with no Origin
# (React Native app, curl) are always allowed. Chrome extension traffic
# uses host_permissions and does not depend on this list.
# Default (if unset): http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Optional yt-dlp helpers
# SYD_COOKIES_FILE=/absolute/path/to/cookies.txt
# SYD_YTDLP_BINARY=yt-dlp

# Optional Google Drive upload (all three required to enable)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Optional existing folder id; otherwise a "ShareYourDownloads" folder is created
# GOOGLE_DRIVE_FOLDER_ID=
